# Production security configuration
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-domain.example
TRUST_PROXY=false

# WordPress integration: keep these ONLY on the server.
WORDPRESS_URL=https://your-domain.example
WORDPRESS_USERNAME=dedicated-api-user
WORDPRESS_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Long random secret for protected administration endpoints.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
